# Local Phase 2 defaults; no AWS or paid model calls are required.
CIVITAS_AUTH_MODE=local
# Optional: enables the local-pilot password recovery form. Keep secret.
CIVITAS_LOCAL_RECOVERY_CODE=
CIVITAS_STORAGE=sqlite
CIVITAS_SQLITE_PATH=.civitas/civitas.sqlite3
CIVITAS_FRONTEND_ORIGIN=http://localhost:5173
# MCP Streamable HTTP transport allowlists. Use the deployed API host in
# production, for example: api.example.com
CIVITAS_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
CIVITAS_MCP_ALLOWED_ORIGINS=
CIVITAS_CORPUS_PATH=data/corpus/manifest.json
CIVITAS_POLICE_REGISTRY_PATH=data/police/bengaluru_stations.json
CIVITAS_CAPABILITY_REGISTRY_PATH=data/capabilities/civic_capabilities.json
CIVITAS_OPA_URL=
CIVITAS_SPATIAL_DATABASE_URL=
CIVITAS_TEMPORAL_TARGET=
CIVITAS_TELEMETRY_ENABLED=false
CIVITAS_TRANSLATION_CACHE_PATH=.civitas/translation-cache.json
CIVITAS_LIVE_CACHE_PATH=.civitas/live-sources.json
CIVITAS_LIVE_STATUS_PATH=.civitas/live-connector-status.json
# Optional cloud durability; use a private S3 bucket and prefixes in AWS.
CIVITAS_LIVE_CACHE_BUCKET=
CIVITAS_LIVE_CACHE_PREFIX=runtime/live-sources/
CIVITAS_LIVE_STATUS_BUCKET=
CIVITAS_LIVE_STATUS_PREFIX=runtime/live-status/
CIVITAS_RESEARCH_STALE_AFTER_DAYS=180
# Event-driven ReAct provider. Groq is the primary; the local read-only Codex
# CLI is the automatic fallback when Groq is unavailable.
CIVITAS_AGENT_PROVIDER=groq
CIVITAS_OLLAMA_BASE_URL=http://127.0.0.1:11434
CIVITAS_OLLAMA_MODEL=hermes3:8b
CIVITAS_AGENT_MAX_ITERATIONS=8
CIVITAS_AGENT_REQUEST_TIMEOUT_SECONDS=90
CIVITAS_AGENT_TOOL_TIMEOUT_SECONDS=30
CIVITAS_AGENT_PROVIDER_RETRIES=3
CIVITAS_AGENT_CONTEXT_MAX_CHARS=48000
CIVITAS_AGENT_CONTEXT_KEEP_MESSAGES=12
CIVITAS_AGENT_GROUNDING_VERIFICATION=true
# Read-only local Codex CLI fallback after Groq retries are exhausted.
CIVITAS_AGENT_CODEX_CLI_FALLBACK=true
CIVITAS_AGENT_CODEX_CLI_TIMEOUT_SECONDS=120
# Keep Codex fallback sessions resumable per private agent thread.
CIVITAS_AGENT_CODEX_CLI_PERSIST_SESSIONS=true
CIVITAS_GROQ_API_KEY=
CIVITAS_GROQ_MODEL=llama-3.3-70b-versatile
# Public OGD access is key-gated by the publisher. Keep these empty until the
# official account/approval is complete; the connector will not send a request.
CIVITAS_DATA_GOV_API_KEY=
CIVITAS_APISETU_CLIENT_ID=
CIVITAS_DIGILOCKER_CLIENT_ID=
CIVITAS_CPGRAMS_CLIENT_ID=
CIVITAS_PARIVAHAN_CLIENT_ID=
CIVITAS_GSTN_CLIENT_ID=
CIVITAS_ABDM_CLIENT_ID=
CIVITAS_ABHA_CLIENT_ID=
# Synthetic connector only; keep false outside local tests.
CIVITAS_DEMO_SUBMISSION_ENABLED=false
# Reviewed browser connector for Greater Bengaluru complaints through Karnataka
# iPGRS. Keep disabled until a deployment has a supervised browser session.
CIVITAS_IPGRS_SUBMISSION_ENABLED=false
CIVITAS_IPGRS_BROWSER_URL=https://ipgrs.karnataka.gov.in/Citizens/GrievanceSelfService
# Set true only for a server with a virtual display; false opens a local browser.
CIVITAS_IPGRS_BROWSER_HEADLESS=false
# Optional certified official API connector. Keep unset until the authority or
# API gateway has issued an endpoint and scoped credential for this project.
CIVITAS_OFFICIAL_API_AUTHORITY_ID=gba
CIVITAS_OFFICIAL_API_URL=
CIVITAS_OFFICIAL_API_STATUS_URL=
CIVITAS_OFFICIAL_API_TOKEN=
CIVITAS_OFFICIAL_API_TIMEOUT_SECONDS=30
